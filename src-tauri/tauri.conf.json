{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Code Manager",
  "version": "0.1.0-beta.1",
  "identifier": "io.github.yeyangchen.claude-code-manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Code Manager",
        "width": 1160,
        "height": 800,
        "minWidth": 860,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Yeyangchen",
    "category": "DeveloperTool",
    "shortDescription": "非官方社区 Claude Code 版本管理工具",
    "longDescription": "Unofficial community tool for managing Claude Code installations. Not affiliated with or endorsed by Anthropic.",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["resources/THIRD_PARTY_NOTICES.txt"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2NjEwQzg5MEZEQUM4NDUKUldSRnlOb1BpUXhoMXJ1Ykc3bXVmNzJJdWkwUkZTWW1zYkV6VDg4SkM0ODUveHdvdzJ2M3N2dXEK",
      "endpoints": [
        "https://github.com/Yeyangchen/claude-code-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
